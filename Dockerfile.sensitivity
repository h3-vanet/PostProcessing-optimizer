# Dedicated analysis-only container for the sensitivity study.
#
# Responsibility split:
#   * ppbo.sif  — post-processing (post_process.py, extract_nr_metrics.py) and BO
#   * sens.sif  — this image: ONLY the sensitivity package
# The coordination between the two happens in sens_step.slurm (a Slurm script,
# outside both containers); no Python process ever invokes apptainer.
#
# The image deliberately does NOT `COPY ./*.py`: it must not carry bo_*.py,
# post_process.py, aggregate_seeds.py, paper_tables.py or the LaTeX generators.
# Post-processing output is produced by the ppbo container and consumed here via
# the host filesystem.
#
# Build (same pipeline as ppbo), from the PostProcessing root:
#   docker build -f Dockerfile.sensitivity -t sensitivity .
#   apptainer build sensitivity.sif docker-daemon://sensitivity:latest
# or through setup_cluster.sh, which names it sensitivity${SIF_SUFFIX:+_$SIF_SUFFIX}.sif
FROM python:3.12.3-slim
WORKDIR /app
# Install both requirements: requirements.txt pins the shared stack (numpy,
# pandas, scikit-learn, ...) and requirements-sensitivity.txt adds the explicit
# sensitivity pins plus pytest. Duplicated pins are intentional and fail loudly
# at build time if the two ever diverge.
COPY ./requirements.txt /app/requirements.txt
COPY ./sensitivity/requirements-sensitivity.txt /app/requirements-sensitivity.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir -r /app/requirements-sensitivity.txt
COPY ./sensitivity /app/sensitivity
ENV MPLBACKEND=Agg
